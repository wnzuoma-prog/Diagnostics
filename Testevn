isolate work area.


# 1. Create a dedicated working directory
mkdir -p /tmp/google_tech_lab && cd /tmp/google_tech_lab

# 2. Allocate two 2GB image files to represent physical drives
dd if=/dev/zero of=sdb.img bs=1M count=2048
dd if=/dev/zero of=sdc.img bs=1M count=2048

# 3. Attach loopback devices
losetup /dev/loop20 sdb.img
losetup /dev/loop21 sdc.img

# 4. Create a mirrored ZFS pool named 'prod_pool'
zpool create prod_pool mirror /dev/loop20 /dev/loop21

# Verify the pool is active and clean
zpool status prod_pool


Inject faults and Host

# 1. Overwrite data blocks on loop21 to force read/write errors
dd if=/dev/urandom of=/dev/loop21 bs=1M count=400 conv=notrunc

# 2. Force ZFS to scrub the array and detect corruption
zpool scrub prod_pool

# 3. Install stress utility (if not already present)
apt-get update && apt-get install -y stress-ng sysstat

# 4. Launch background I/O stress to simulate high system contention
stress-ng --io 2 --vm 1 --vm-bytes 256M --timeout 120s &
